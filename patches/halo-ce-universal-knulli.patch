+#ifdef HALO_ANDROID
+/* ---------- shader programs kept on disk (ES)
+
+Mali compiles and links a program in tens to hundreds of milliseconds: in
+the middle of a frame the first time a combination of shaders is drawn with,
+and again at every start. Linked programs are therefore kept, as the
+driver's binaries, in shaders/ of the save folder, named by a hash of their
+two sources and the driver's version; a program found there is loaded
+without compiling anything. So that it need not be, compile_shader only
+keeps a shader's source, and returns a handle to it: the shaders are
+compiled when a program that uses them is linked. */
+
+#define LAZY_SHADER 0x40000000u
+/* changes to what the port expects of a linked program invalidate the cache */
+#define PROGRAM_CACHE_VERSION 1
+
+struct lazy_shader
+{
+	GLenum type;
+	char *source;
+	unsigned long long hash;
+	GLuint shader;
+	BOOL failed;
+	const char *what;
+};
+
+static struct lazy_shader *lazy_shaders;
+static unsigned long lazy_shader_count, lazy_shader_capacity;
+
+static unsigned long long hash_text(const char *text, unsigned long long hash)
+{
+	while (*text)
+		hash = (hash ^ (unsigned char)*text++) * 1099511628211ull;
+	return hash;
+}
+
+static GLuint compile_shader(GLenum type, const char *source, const char *what)
+{
+	struct lazy_shader *shader;
+
+	if (lazy_shader_count == lazy_shader_capacity)
+	{
+		lazy_shader_capacity = lazy_shader_capacity ? lazy_shader_capacity * 2 : 256;
+		lazy_shaders = realloc(lazy_shaders, lazy_shader_capacity * sizeof(*lazy_shaders));
+	}
+	shader = &lazy_shaders[lazy_shader_count];
+	memset(shader, 0, sizeof(*shader));
+	shader->type = type;
+	shader->source = strdup(source);
+	shader->hash = hash_text(source, 14695981039346656037ull);
+	shader->what = what;
+	return LAZY_SHADER | (GLuint)lazy_shader_count++;
+}
+
+static struct lazy_shader *lazy_shader_get(GLuint handle)
+{
+	unsigned long index = handle & ~LAZY_SHADER;
+
+	return (handle & LAZY_SHADER) && index < lazy_shader_count ? &lazy_shaders[index] : NULL;
+}
+
+/* the GL shader for a handle, compiled now if it has not been */
+static GLuint lazy_shader_compile(GLuint handle)
+{
+	struct lazy_shader *shader = lazy_shader_get(handle);
+
+	if (!shader)
+		return handle;
+	if (!shader->shader && !shader->failed)
+	{
+		shader->shader = compile_shader_now(shader->type, shader->source, shader->what);
+		shader->failed = !shader->shader;
+		free(shader->source);
+		shader->source = NULL;
+	}
+	return shader->shader;
+}
+
+static const char *program_cache_folder(void)
+{
+	static char folder[512];
+	static int made;
+
+	if (!made)
+	{
+		made = 1;
+		if (!config_boolean("debug.no_program_cache"))
+		{
+			snprintf(folder, sizeof(folder), "%s/shaders", platform_save_root());
+			posix_make_directory(folder);
+		}
+	}
+	return folder;
+}
+
+static unsigned long long program_key(GLuint vertex_shader, GLuint fragment_shader)
+{
+	static unsigned long long driver;
+	struct lazy_shader *vertex = lazy_shader_get(vertex_shader);
+	struct lazy_shader *fragment = lazy_shader_get(fragment_shader);
+	unsigned long long key;
+
+	if (!driver)
+	{
+		driver = hash_text((const char *)glGetString(GL_VERSION), 14695981039346656037ull);
+		driver = hash_text((const char *)glGetString(GL_RENDERER), driver) + PROGRAM_CACHE_VERSION;
+	}
+	if (!vertex || !fragment)
+		return 0;
+	key = (driver ^ vertex->hash) * 1099511628211ull;
+	return (key ^ fragment->hash) * 1099511628211ull;
+}
+
+/* a program from the cache, or 0 */
+static GLuint program_cache_load(unsigned long long key)
+{
+	const char *folder = program_cache_folder();
+	char path[600];
+	FILE *file;
+	unsigned int header[2];
+	void *binary;
+	GLuint program = 0;
+	GLint status = 0;
+
+	if (!*folder || !key)
+		return 0;
+	snprintf(path, sizeof(path), "%s/%016llx.bin", folder, key);
+	if (!(file = fopen(path, "rb")))
+		return 0;
+	if (fread(header, sizeof(header), 1, file) == 1 && header[1] && header[1] < 16u * 1024 * 1024 &&
+		(binary = malloc(header[1])) != NULL)
+	{
+		if (fread(binary, header[1], 1, file) == 1)
+		{
+			program = glCreateProgram();
+			glProgramBinary(program, (GLenum)header[0], binary, (GLsizei)header[1]);
+			glGetProgramiv(program, GL_LINK_STATUS, &status);
