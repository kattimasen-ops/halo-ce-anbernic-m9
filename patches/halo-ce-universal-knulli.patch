+	for (index = decal_get_first_decal_index(cluster_index, local_layer); index != NONE && count < capacity;
+		index = DECAL_GET(index)->next_decal_index)
+	{
+		struct decal_datum *decal = DECAL_GET(index);
+		struct decal_shader_definition *shader = &decal_definition_get(decal->definition_index)->shader;
