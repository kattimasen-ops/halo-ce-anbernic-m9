+#ifdef HALO_ANDROID
+/* The Mali port draws consecutive quads of the same state as one draw
+(port/linux/src/d3d8_gl.c), and a decal's quads are drawn by themselves
+whenever its bitmap differs from the one before. Decals whose blend function
+does not depend on the order they are drawn in (all but alpha blending) are
+therefore drawn grouped by blend function and bitmap, within each run of
+such decals in the list: the picture is the same, in far fewer draws. */
+
+static boolean decal_order_independent(short framebuffer_blend_function)
+{
+	return framebuffer_blend_function != _shader_framebuffer_blend_function_alpha_blend &&
+		framebuffer_blend_function != _shader_framebuffer_blend_function_alpha_multiply_add;
+}
+
+/* the cluster's decals in drawing order; returns their count */
+static long decal_drawing_order(short cluster_index, long *order, long capacity)
+{
+	/* an order independent decal's key: a flag, its blend function, bitmap
+	and place in the list (so that the sort is stable); 0 for the others */
+	static unsigned long long keys[MAXIMUM_DECALS_PER_MAP];
+	long count = 0, run, end, index, place;
+
+	for (index = decal_get_first_decal_index(cluster_index, local_layer); index != NONE && count < capacity;
+		index = DECAL_GET(index)->next_decal_index)
+	{
+		struct decal_datum *decal = DECAL_GET(index);
+		struct decal_shader_definition *shader = &decal_definition_get(decal->definition_index)->shader;
+
+		keys[count] = decal_order_independent(shader->framebuffer_blend_function) ?
+			1ULL << 48 | (unsigned long long)(unsigned short)shader->framebuffer_blend_function << 40 |
+			(unsigned long long)(shader->map.index & 0xffff) << 24 | (unsigned long long)(unsigned char)decal->bitmap_index << 16 |
+			(unsigned long long)count : 0;
+		order[count++] = index;
+	}
+	/* an insertion sort of each run of order independent decals */
+	for (run = 0; run < count; run = end + 1)
+	{
+		for (end = run; end < count && keys[end]; end++)
+		{
+			unsigned long long key = keys[end];
+			long moving = order[end];
+
+			for (place = end; place > run && keys[place - 1] > key; place--)
+			{
+				keys[place] = keys[place - 1];
+				order[place] = order[place - 1];
+			}
+			keys[place] = key;
+			order[place] = moving;
+		}
+	}
+	return count;
+}
+#endif
