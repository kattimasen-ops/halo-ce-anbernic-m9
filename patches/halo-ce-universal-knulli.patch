+/* ---------- buffers mapped once
+
+With GL_EXT_buffer_storage the renderer's streaming buffers are mapped for
+good when they are made (host_gl_buffer_persistent), and a write into one is
+a copy: mapping and unmapping for each write cost Mali's driver about 8 us a
+call, some 450 calls a frame. host_gl_wait_frame still releases a buffer
+only once the GPU is done with the frame that last used it. */
+
+#define PERSISTENT_BUFFERS 8
+
+static struct
+{
+	GLuint buffer;
+	unsigned char *mapping;
+	uint32_t size;
+} persistent_buffers[PERSISTENT_BUFFERS];
+static int persistent_buffer_count;
+
+static GLenum buffer_binding(uint32_t target)
+{
+	switch (target)
+	{
+	case GL_ARRAY_BUFFER: return GL_ARRAY_BUFFER_BINDING;
+	case GL_ELEMENT_ARRAY_BUFFER: return GL_ELEMENT_ARRAY_BUFFER_BINDING;
+	default: return 0;
+	}
+}
+
+/* where to write size bytes at offset of the buffer bound to target, if it
+is mapped for good */
+static unsigned char *persistent_mapping(uint32_t target, uint32_t offset, uint32_t size)
+{
+	GLenum binding = buffer_binding(target);
+	GLint buffer = 0;
+	int index;
+
+	if (!binding)
+		return NULL;
+	glGetIntegerv(binding, &buffer);
+	for (index = 0; index < persistent_buffer_count; index++)
+	{
+		if (persistent_buffers[index].buffer == (GLuint)buffer)
+		{
+			if ((uint64_t)offset + size > persistent_buffers[index].size)
+				return NULL;
+			return persistent_buffers[index].mapping + offset;
+		}
+	}
+	return NULL;
+}
+
+/* gives the buffer bound to target size bytes of storage: mapped for good
+where the driver can (the writes are then copies), or ordinary storage */
+void host_gl_buffer_persistent(uint32_t target, uint32_t size)
+{
+	typedef void (GL_APIENTRY *buffer_storage_function)(GLenum, GLsizeiptr, const void *, GLbitfield);
+	static buffer_storage_function buffer_storage;
+	static int looked;
+	GLenum binding = buffer_binding(target);
+	GLint buffer = 0;
+
+	if (!looked)
+	{
+		looked = 1;
+		if (host_gl_has_extension("GL_EXT_buffer_storage"))
+			buffer_storage = (buffer_storage_function)eglGetProcAddress("glBufferStorageEXT");
+		if (!buffer_storage)
+			buffer_storage = (buffer_storage_function)host_gl_resolve("glBufferStorageEXT");
+		host_logf(HOST_LOG_INFO, "buffer storage: extension %d, function %p",
+			host_gl_has_extension("GL_EXT_buffer_storage"), (void *)buffer_storage);
+	}
+	if (binding)
+		glGetIntegerv(binding, &buffer);
+	if (buffer_storage && buffer && persistent_buffer_count < PERSISTENT_BUFFERS)
+	{
+		/* GL_MAP_PERSISTENT_BIT_EXT, and flushed by hand: a coherent mapping
+		is uncached memory on Mali, where a 3 KB copy took some 6 us */
+		GLbitfield flags = GL_MAP_WRITE_BIT | GL_MAP_READ_BIT | 0x0040;
+		void *mapping;
+
+		while (glGetError() != GL_NO_ERROR)
+			;
+		buffer_storage(target, size, NULL, flags);
+		flags |= GL_MAP_FLUSH_EXPLICIT_BIT;
+		{
+			GLenum error = glGetError();
+
+			if (error != GL_NO_ERROR)
+				host_logf(HOST_LOG_WARN, "buffer %d: glBufferStorageEXT error %04x", buffer, error);
+			else
+			{
+				mapping = glMapBufferRange(target, 0, size, flags);
+				if (!mapping)
+					host_logf(HOST_LOG_WARN, "buffer %d: mapping failed, error %04x", buffer, glGetError());
+				if (mapping)
+				{
+					host_logf(HOST_LOG_INFO, "buffer %d mapped for good (%u bytes)", buffer, size);
+					persistent_buffers[persistent_buffer_count].buffer = (GLuint)buffer;
+					persistent_buffers[persistent_buffer_count].mapping = mapping;
+					persistent_buffers[persistent_buffer_count].size = size;
+					persistent_buffer_count++;
+				}
+				return;
+			}
+		}
+		if (0)
+		{
+			mapping = glMapBufferRange(target, 0, size, flags);
+			if (mapping)
+			{
+				host_logf(HOST_LOG_INFO, "buffer %d mapped for good (%u bytes)", buffer, size);
+				persistent_buffers[persistent_buffer_count].buffer = (GLuint)buffer;
+				persistent_buffers[persistent_buffer_count].mapping = mapping;
+				persistent_buffers[persistent_buffer_count].size = size;
+				persistent_buffer_count++;
+			}
+			/* immutable storage either way; unmapped, writes map and unmap */
+			return;
+		}
+	}
+	glBufferData(target, size, NULL, GL_STREAM_DRAW);
+}
+
+void host_gl_buffer_write(uint32_t target, uint32_t offset, uint32_t size, const void *data);
+
+/* host_gl_buffer_write for a buffer the caller names: a copy when it is
+mapped for good, without asking the driver which buffer is bound (Mali's
+glGetIntegerv costs a few microseconds); otherwise as host_gl_buffer_write,
+into the buffer bound to target (the caller binds it) */
+void host_gl_buffer_write_to(uint32_t buffer, uint32_t target, uint32_t offset, uint32_t size, const void *data)
+{
+	int index;
+
+	for (index = 0; index < persistent_buffer_count; index++)
+	{
+		if (persistent_buffers[index].buffer == buffer)
+		{
+			if ((uint64_t)offset + size <= persistent_buffers[index].size)
+			{
+				memcpy(persistent_buffers[index].mapping + offset, data, size);
+				glFlushMappedBufferRange(target, offset, size);
+				return;
+			}
+			break;
+		}
+	}
+	host_gl_buffer_write(target, offset, size, data);
+}
