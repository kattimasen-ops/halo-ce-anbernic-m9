+/* ---------- visibility test results, without waiting for the GPU
+
+The game asks for its visibility tests' counts (lens flares, the lights'
+occlusion) at the start of the next frame. Reading the counter buffer then
+waits for the GPU to finish every draw before, and with the GL thread
+(port/knulli) for that thread to empty its queue too: the game, the driver
+and the GPU in lockstep once a frame. Instead, at the end of each frame
+the counters are copied into the next of three read-back buffers, and the
+copy made three frames before, which the GPU has long finished (the stream
+buffers' fences are two frames behind), is read without waiting. A test's
+count is known two or three frames after it was drawn, as on the NV2A
+while the GPU was behind. */
+
+#define VISIBILITY_FRAMES 3
+
+static struct
+{
+	GLuint buffer;
+	uint32_t size;
+	uint32_t pair_count;
+	uint32_t pairs[HALO_VISIBILITY_FRAME_TESTS][2];
+	int valid;
+} visibility_frames[VISIBILITY_FRAMES];
+static uint32_t visibility_results[HALO_VISIBILITY_RESULTS];
+static uint32_t visibility_frame;
+
+/* the end of a frame: counters is the counter buffer, pairs its tests (the
+game's index and the counter's), pair_count of them */
+void host_gl_visibility_frame(uint32_t counters, uint32_t counter_bytes, const uint32_t *pairs, uint32_t pair_count)
+{
+	unsigned int slot = visibility_frame++ % VISIBILITY_FRAMES;
+	GLint previous_read = 0, previous_write = 0;
+	uint32_t index;
+
+	glGetIntegerv(GL_COPY_READ_BUFFER_BINDING, &previous_read);
+	glGetIntegerv(GL_COPY_WRITE_BUFFER_BINDING, &previous_write);
+	if (visibility_frames[slot].valid)
+	{
+		const uint32_t *values;
+
+		glBindBuffer(GL_COPY_READ_BUFFER, visibility_frames[slot].buffer);
+		values = glMapBufferRange(GL_COPY_READ_BUFFER, 0, visibility_frames[slot].size, GL_MAP_READ_BIT);
+		if (values)
+		{
+			for (index = 0; index < visibility_frames[slot].pair_count; index++)
+			{
+				uint32_t test = visibility_frames[slot].pairs[index][0];
+				uint32_t counter = visibility_frames[slot].pairs[index][1];
+
+				if (test < HALO_VISIBILITY_RESULTS && counter * sizeof(uint32_t) < visibility_frames[slot].size)
+					__atomic_store_n(&visibility_results[test], values[counter], __ATOMIC_RELAXED);
+			}
+			glUnmapBuffer(GL_COPY_READ_BUFFER);
+		}
+		visibility_frames[slot].valid = 0;
+	}
+	if (pair_count && counter_bytes)
+	{
+		if (!visibility_frames[slot].buffer || visibility_frames[slot].size != counter_bytes)
+		{
+			if (!visibility_frames[slot].buffer)
+				glGenBuffers(1, &visibility_frames[slot].buffer);
+			glBindBuffer(GL_COPY_WRITE_BUFFER, visibility_frames[slot].buffer);
+			glBufferData(GL_COPY_WRITE_BUFFER, counter_bytes, NULL, GL_STREAM_READ);
+			visibility_frames[slot].size = counter_bytes;
+		}
+		glBindBuffer(GL_COPY_READ_BUFFER, counters);
+		glBindBuffer(GL_COPY_WRITE_BUFFER, visibility_frames[slot].buffer);
+		glCopyBufferSubData(GL_COPY_READ_BUFFER, GL_COPY_WRITE_BUFFER, 0, 0, counter_bytes);
+		if (pair_count > HALO_VISIBILITY_FRAME_TESTS)
+			pair_count = HALO_VISIBILITY_FRAME_TESTS;
+		memcpy(visibility_frames[slot].pairs, pairs, pair_count * 2 * sizeof(uint32_t));
+		visibility_frames[slot].pair_count = pair_count;
+		visibility_frames[slot].valid = 1;
+	}
+	glBindBuffer(GL_COPY_READ_BUFFER, (GLuint)previous_read);
+	glBindBuffer(GL_COPY_WRITE_BUFFER, (GLuint)previous_write);
+}
+
+/* the latest known count of the game's test index */
+uint32_t host_gl_visibility_result(uint32_t index)
+{
+	return __atomic_load_n(&visibility_results[index % HALO_VISIBILITY_RESULTS], __ATOMIC_RELAXED);
+}
