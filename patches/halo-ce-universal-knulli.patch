+/* the cluster's decals in drawing order; returns their count */
+static long decal_drawing_order(short cluster_index, long *order, long capacity)
+{
+	/* an order independent decal's key: a flag, its blend function, bitmap
+	and place in the list (so that the sort is stable); 0 for the others */
+	static unsigned long long keys[MAXIMUM_DECALS_PER_MAP];
+	long count = 0, run, end, index, place;
