+such decals in the list: the picture is the same, in far fewer draws. */
+
+static boolean decal_order_independent(short framebuffer_blend_function)
+{
+	return framebuffer_blend_function != _shader_framebuffer_blend_function_alpha_blend &&
+		framebuffer_blend_function != _shader_framebuffer_blend_function_alpha_multiply_add;
