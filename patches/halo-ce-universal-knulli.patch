+static BOOL draw_signature_count(D3DPRIMITIVETYPE primitive_type, UINT vertex_count, const WORD *index_data)
+{
+	static struct
+	{
+		unsigned long hash;
+		unsigned long draws;
+	} slots[DRAW_SIGNATURE_SLOTS];
+	static unsigned long frame, frames, draws, repeats, groups, previous_hash;
+	static unsigned long consecutive;
+	unsigned long words[20], hash = 2166136261UL, index, slot;
+	int stage;
+
+	if (frame != device.frame)
+	{
+		/* the frame before: its repeated signatures */
+		for (slot = 0; slot < DRAW_SIGNATURE_SLOTS; slot++)
+		{
+			if (slots[slot].draws > 1)
+				groups++;
+		}
+		memset(slots, 0, sizeof(slots));
+		frame = device.frame;
+		if (++frames == 300)
+		{
+			platform_log("draw signatures: %lu indexed draws a frame, %lu of them repeat a draw of the frame "
+				"(%lu groups), %lu repeat the draw just before", draws / frames, repeats / frames, groups / frames,
+				consecutive / frames);
+			frames = draws = repeats = groups = consecutive = 0;
+		}
+	}
+	index = 0;
+	words[index++] = (unsigned long)device.vertex_shader;
+	for (stage = 0; stage < 4; stage++)
+		words[index++] = device.textures[stage] ? (unsigned long)device.textures[stage]->Data : 0;
+	words[index++] = (unsigned long)device.streams[0].data;
+	words[index++] = device.streams[0].stride;
+	words[index++] = (unsigned long)index_data;
+	words[index++] = vertex_count;
+	words[index++] = primitive_type;
+	words[index++] = D3D__RenderState[D3DRS_ALPHABLENDENABLE];
+	words[index++] = D3D__RenderState[D3DRS_SRCBLEND];
+	words[index++] = D3D__RenderState[D3DRS_DESTBLEND];
+	words[index++] = D3D__RenderState[D3DRS_CULLMODE];
+	words[index++] = D3D__RenderState[D3DRS_ZWRITEENABLE];
+	words[index++] = D3D__RenderState[D3DRS_ALPHATESTENABLE];
+	words[index++] = D3D__RenderState[D3DRS_PSCOMBINERCOUNT];
+	words[index++] = D3D__RenderState[D3DRS_PSTEXTUREMODES];
+	while (index > 0)
+		hash = (hash ^ words[--index]) * 16777619UL;
+	hash |= 1;
+	draws++;
+	if (hash == previous_hash)
+		consecutive++;
+	previous_hash = hash;
+	for (slot = hash % DRAW_SIGNATURE_SLOTS; slots[slot].draws && slots[slot].hash != hash;
+		slot = (slot + 1) % DRAW_SIGNATURE_SLOTS)
+		;
+	if (slots[slot].draws)
+		repeats++;
+	slots[slot].hash = hash;
+	slots[slot].draws++;
+	/* debug.draw_callers = 4: repeated draws are not drawn, to measure what
+	drawing them as instances could gain (the picture misses them) */
+	return slots[slot].draws > 1 && debug_settings.draw_callers == 4;
+}
+
+/* the busiest first */
+static int draw_caller_compare(const void *a, const void *b)
+{
+	unsigned long first = ((const unsigned long *)a)[1], second = ((const unsigned long *)b)[1];
+
+	return first < second ? 1 : first > second ? -1 : 0;
+}
+
+static void draw_caller_count(void *address, unsigned long vertices)
+{
+	static unsigned long first_frame;
+	unsigned long slot, probe;
+
+#ifdef HALO_ANDROID
+	if (!debug_settings.draw_callers)
+		return;
+#else
+	return;
+#endif
+	slot = ((unsigned long)address >> 2) % DRAW_CALLER_SLOTS;
+	for (probe = 0; probe < DRAW_CALLER_SLOTS; probe++, slot = (slot + 1) % DRAW_CALLER_SLOTS)
+	{
+		if (!draw_callers[slot].address || draw_callers[slot].address == (unsigned long)address)
+		{
+			draw_callers[slot].address = (unsigned long)address;
+			draw_callers[slot].draws++;
+			draw_callers[slot].vertices += vertices;
+			break;
+		}
