+
+		if (persistent)
+		{
+			memcpy(persistent, data, size);
+			glFlushMappedBufferRange(target, offset, size);
+			return;
+		}
+	}
+	mapping = glMapBufferRange(target, offset, size,
 		GL_MAP_WRITE_BIT | GL_MAP_UNSYNCHRONIZED_BIT);
 
 	if (!mapping)
