+		keys[count] = decal_order_independent(shader->framebuffer_blend_function) ?
+			1ULL << 48 | (unsigned long long)(unsigned short)shader->framebuffer_blend_function << 40 |
+			(unsigned long long)(shader->map.index & 0xffff) << 24 | (unsigned long long)(unsigned char)decal->bitmap_index << 16 |
+			(unsigned long long)count : 0;
